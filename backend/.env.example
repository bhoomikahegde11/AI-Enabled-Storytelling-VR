# Hardware Adaptive AI Loading Override
USE_GPU=true
# true = auto use CUDA if available
# false = force CPU mode for testing / compatibility

# LLM Personality Rewriting Layer
USE_LLM_PERSONALITY=true
# true = enable GGUF LLM dialogue rephrasing for NPC personality
# false = use deterministic templates only (faster, useful for demos/testing)

# Speech Synthesizer Toggle ("piper", "openai", "elevenlabs")
TTS_PROVIDER=piper

# (Optional) Online cloud credentials for ElevenLabs or OpenAI
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
VOICE_ID=yCxjZ3dvaYYrkVmdHAe9

# Whisper Speech-to-Text Model Quality (GPU mode default: small.en)
# Available models: tiny.en, base.en, small.en, medium.en
WHISPER_MODEL=small.en

